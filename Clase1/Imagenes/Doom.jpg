 inherit; font-kerning: inherit; font-feature-settings: inherit; font-varia=
tion-settings: inherit; font-language-override: inherit; font-size: 100%; m=
argin: 0px; padding: 0px 0px 0px 24px; position: relative; vertical-align: =
baseline; white-space: nowrap; }

@media (max-width: 500px) {
  ._acus { padding-left: 0px; }
